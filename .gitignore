# Devenv
.devenv*
devenv.local.nix
devenv.local.yaml

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# mdbook build output
# The book lives at ``docs/current/`` (mdbook init layout). Both of the
# below are reproducible from ``docs/current/src/`` via
# ``mdbook build docs/current`` (or ``just docs-build``):
#   - ``docs/current/book/``     — generated HTML
#   - ``docs/current/src/d2/``   — d2 preprocessor SVGs (relative
#                                  to the source dir per the d2
#                                  plugin's ``output-dir = "d2"``)
docs/current/book/
docs/current/src/d2/

# Python
__pycache__/
*.pyc
*.egg-info/

# Training outputs
outputs/

# Build outputs — regenerable from source; ignored by convention
# (covers patched-src/, wheels/, jvm-libs/, draft-*.md, config/, experiments/ …)
# build/dev/{archive,current,scratch} = the KB PROJECTION (built from the canonical
# ontology submodule + domain-adapted overlay); regenerable, hence ignored. The
# source of record is the submodule (what we SHARE); the projection is what we KNOW.
build/

# Devenv runtime state (postgres data dir, qdrant init sentinel)
/db/
.qdrant-initialized

# UI build artifacts + dependency tree
ui/node_modules/
ui/dist/
ui/tsconfig.tsbuildinfo

# Per-session scratch (research notes, screenshots, ad-hoc dumps)
*.png
domain-choice.txt
micans*.txt
docs/scratch/

# Extracted dataset artifacts published to HuggingFace separately —
# the cards live in-repo; the binary parquet / npy do not.
data/correspondence_*/correspondence.parquet
data/correspondence_*/T_I_centroids.npy

# Local environment + secrets (devenv dotenv) and Claude Code local state
.env
.claude/settings.local.json

# Metaflow local-mode run metadata (local datastore lives on /raid)
.metaflow/

# editor swap files + JVM crash logs (junk)
*.swp
*~
hs_err_pid*.log
